{
  "appId": "com.cleannotesjoe.sender",
  "productName": "Clean Notes Joe Sender",
  "extraMetadata": {
    "main": "sender-main.js",
    "name": "clean-notes-joe-sender",
    "description": "Sends PowerPoint's current slide and notes to Clean Notes Joe on other PCs"
  },
  "directories": {
    "output": "dist"
  },
  "win": {
    "target": [
      "portable"
    ],
    "icon": "logo.ico"
  },
  "portable": {
    "artifactName": "${productName} ${version} Portable.exe"
  },
  "mac": {
    "target": [
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "icon": "icon.png",
    "category": "public.app-category.productivity",
    "extendInfo": {
      "NSAppleEventsUsageDescription": "Clean Notes Joe Sender follows the slide PowerPoint is showing, to send its notes."
    }
  },
  "files": [
    "package.json",
    "sender-main.js",
    "sender-preload.js",
    "sender.html",
    "live.js",
    "network.js",
    "pptx.js",
    "logo.png",
    "logo.ico",
    "icon.png"
  ]
}
