{
  "name": "clean-notes-joe",
  "version": "0.9.2",
  "description": "Speaker notes from PowerPoint, fullscreen on a second display, with auto-fit and auto-scroll. Includes Clean Notes Joe Sender for PowerPoint PCs (Windows)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/pptx.test.js && node test/network.test.js && node test/version.test.js",
    "version": "node test/version.test.js && git add CHANGELOG.md",
    "build": "electron-builder --win --x64 && electron-builder --win --x64 --config electron-builder.sender.json",
    "build:win": "electron-builder --win --x64 && electron-builder --win --x64 --config electron-builder.sender.json",
    "start:sender": "electron sender-main.js",
    "build:mac": "electron-builder --mac && electron-builder --mac --config electron-builder.sender.json"
  },
  "author": "Joseph Stracuzzi",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cleannotesjoe.app",
    "productName": "Clean Notes Joe",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "logo.ico"
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "pptx.js",
      "live.js",
      "network.js",
      "notes-view.js",
      "index.html",
      "output.html",
      "logo.png",
      "logo.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "test_decks",
        "to": "test_decks"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Clean Notes Joe follows the slide PowerPoint is showing."
      }
    }
  }
}
